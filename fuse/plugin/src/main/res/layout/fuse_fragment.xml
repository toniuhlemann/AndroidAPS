<?xml version="1.0" encoding="utf-8"?>
<!-- Bewusst schlicht: EIN Textfeld in Monospace. Der gesamte Inhalt entsteht in
     FuseScreenModel und ist damit ohne Geraet pruefbar. Eine Zeilenliste aus
     inflatierten Layouts haette dieselbe Information gekostet, aber die
     Testflaeche verdoppelt. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <!-- Der EINE Bedienknopf des Reiters. Er dosiert nichts und rechnet
         nichts - er setzt einen Zeitstempel, den der naechste Zyklus liest. -->
    <Button
        android:id="@+id/fuse_meal_marker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:text="@string/fuse_meal_marker_button" />

    <TextView
        android:id="@+id/fuse_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:textIsSelectable="true"
        android:fontFamily="monospace"
        android:textSize="12sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
