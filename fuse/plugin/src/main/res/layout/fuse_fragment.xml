<?xml version="1.0" encoding="utf-8"?>
<!-- Bewusst schlicht: EIN Textfeld in Monospace. Der gesamte Inhalt entsteht in
     FuseScreenModel und ist damit ohne Geraet pruefbar. Eine Zeilenliste aus
     inflatierten Layouts haette dieselbe Information gekostet, aber die
     Testflaeche verdoppelt. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <!-- DER Mahlzeiten-Marker. Er dosiert nichts und rechnet nichts - er
         setzt einen Zeitstempel, den der naechste Zyklus liest. Ein Druck bei
         aktivem Marker nimmt ihn zurueck. Seit 11.08. genau EINER: die Stufen
         S/M/L waren eine Mengenschaetzung, und die Menge steht in der
         Freigabe-Huelle, nicht im Knopf. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="4dp">
        <Button
            android:id="@+id/fuse_meal_marker"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:text="@string/fuse_marker_m" />
    </LinearLayout>

    <TextView
        android:id="@+id/fuse_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:textIsSelectable="true"
        android:fontFamily="monospace"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="13sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
