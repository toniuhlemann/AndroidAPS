<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <!-- Ein Marker, eine Bedeutung. Der Dialog erklaert die Exposition;
             die Karten darunter zeigen den laufenden Verbrauch. -->
        <Button
            android:id="@+id/fuse_meal_marker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:text="@string/fuse_marker_m" />

        <!-- Karte 1: Betriebszustand. Bewusst OHNE fette Zwischentitel -
             die Inhaltszeilen tragen ihre Beschriftung selbst, und jede
             gesparte Zeile bringt die Mahlzeit-/Evidenzkarte weiter nach
             oben (Toni 15.08.: das Blatt nicht aufblaehen). -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.MaterialComponents.CardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="6dp"
            app:cardElevation="2dp"
            app:cardUseCompatPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/fuse_overview_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="READY" />

                <TextView
                    android:id="@+id/fuse_overview_status_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorSecondary"
                    tools:text="vor 0 min | Phase ARMED | Health READY" />

                <TextView
                    android:id="@+id/fuse_overview_signal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="?android:attr/textColorPrimary"
                    tools:text="Störung r +0.55 mg/dl/min | Anstieg | SMB-Anteil 0.25" />

                <TextView
                    android:id="@+id/fuse_overview_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="SMB 0.20 U -&gt; 0.20 U | keine neue TBR" />

                <TextView
                    android:id="@+id/fuse_overview_smb_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="SMB STOP EXPOSURE | CORRECTION | CAP 2.50 U | belegt 2.20 U | frei 0.00 U" />

                <TextView
                    android:id="@+id/fuse_overview_reason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?android:attr/textColorPrimary"
                    tools:text="Guard-Boden (guardFloor=70.0)" />

                <TextView
                    android:id="@+id/fuse_overview_gate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    tools:text="Gate VPUMP_ALPHA | Ledger frei" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Karte 2: Mahlzeit und Evidenz - die neuen Regeln gehoeren nach
             oben: Marker, Episode (Phase/Alter/verbucht), Bestand/Kredit,
             Totband-/Prime-/Onset-Status. Die Fensterzeile verschwindet,
             wenn nichts aktiv ist (Null-Info verstecken). -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.MaterialComponents.CardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="6dp"
            app:cardElevation="2dp"
            app:cardUseCompatPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fuse_meal_evidence"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/fuse_overview_marker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?android:attr/textColorPrimary"
                    tools:text="AKTIV seit 3/90 min | Huelle 3.00 U | publiziert 0.20 U | verfuegbar 2.80 U" />

                <TextView
                    android:id="@+id/fuse_overview_evidence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?android:attr/textColorPrimary"
                    tools:text="Episode AKTIV | 124/360 min | verbucht 2.10 U&#10;Bestand 12 mg/dl | Kredit +0.40/min" />

                <TextView
                    android:id="@+id/fuse_overview_windows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:visibility="gone"
                    tools:text="Nacht-Totband entwaffnet (Kredit) | Prime 0.40 U offen"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/fuse_overview_upfront_batch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:visibility="gone"
                    tools:text="Sofort geplant 3.20 U | geliefert 0.60 U | offen 2.60 U | aufgeschoben (Sicherheitsriegel)"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Karte 3: Budget und Profil - EIN IOB, EIN Spielraum, EIN Profil.
             Kappen-IOB wohnt in den technischen Details; Transport erscheint
             nur, wenn tatsaechlich etwas offen ist. -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.MaterialComponents.CardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="6dp"
            app:cardElevation="2dp"
            app:cardUseCompatPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fuse_budget_profile"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/fuse_overview_iob_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?android:attr/textColorPrimary"
                    tools:text="IOB -0.07 U  (Bolus 0.35 | Basal -0.42)" />

                <TextView
                    android:id="@+id/fuse_overview_transport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:visibility="gone"
                    tools:text="Transport offen 0.10 U - wird vom Spielraum abgezogen"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/fuse_overview_limits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?android:attr/textColorPrimary"
                    tools:text="Verfuegbar 7.65 U (beide Grenzen)&#10;iobTH 8.00 | maxIOB 8.00 U" />

                <TextView
                    android:id="@+id/fuse_overview_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?android:attr/textColorSecondary"
                    tools:text="Ziel 98 mg/dl (Profil) | ISF 80 mg/dl/U | Basal 0.65 U/h" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/fuse_open_settings"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/fuse_open_settings" />

            <Button
                android:id="@+id/fuse_details_toggle"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/fuse_show_details" />
        </LinearLayout>

        <!-- Vollstaendige technische Belegschicht. Sie bleibt absichtlich
             Monospace und selektierbar, ist aber im Alltag eingeklappt.
             Ganz unten drin: der Einstellungs-Bericht (alle Werte, Abweichung
             vom Standard mit * markiert). -->
        <TextView
            android:id="@+id/fuse_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textIsSelectable="true"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
